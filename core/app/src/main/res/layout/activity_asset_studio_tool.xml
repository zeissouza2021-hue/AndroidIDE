<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/asset_studio_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/asset_studio_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/asset_studio_section_source"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/asset_studio_btn_import_svg"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/asset_studio_import_svg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/asset_studio_btn_import_image"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/asset_studio_import_image" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/asset_studio_btn_paste_xml"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/asset_studio_paste_xml" />

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/asset_studio_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/asset_studio_status_ready"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/asset_studio_section_name"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/asset_studio_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/asset_studio_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/asset_studio_section_output"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <RadioGroup
                android:id="@+id/asset_studio_output_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checkedButton="@+id/asset_studio_output_vector"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/asset_studio_output_vector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/asset_studio_output_vector" />

                <RadioButton
                    android:id="@+id/asset_studio_output_png"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/asset_studio_output_png" />

                <RadioButton
                    android:id="@+id/asset_studio_output_launcher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/asset_studio_output_launcher" />

            </RadioGroup>

            <LinearLayout
                android:id="@+id/asset_studio_launcher_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/asset_studio_section_launcher_options"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/asset_studio_background_color"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <View
                        android:id="@+id/asset_studio_bg_color_preview"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="12dp"
                        android:background="?attr/colorPrimary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/asset_studio_bg_color_hex"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:singleLine="true"
                            android:text="#FF6200EE" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/asset_studio_fg_scale_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/asset_studio_foreground_scale"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/asset_studio_fg_scale_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="72"
                    android:valueFrom="40"
                    android:valueTo="100"
                    android:stepSize="1" />

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/asset_studio_section_preview"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSurfaceVariant">

                <ImageView
                    android:id="@+id/asset_studio_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/asset_studio_btn_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/asset_studio_import" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
